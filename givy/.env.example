# 1. RDS 데이터베이스 접속 정보
SPRING_DATASOURCE_URL=jdbc:mysql://givy-db.craqig8oi76h.ap-northeast-2.rds.amazonaws.com:3306/givy?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=your_admin_id
SPRING_DATASOURCE_PASSWORD=your_admin_password

# 2. 로컬 DB 비밀번호 (팀원 각자 환경에 맞게 수정)
DB_PWD=your_local_password

# 3. JWT 보안 설정
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION_MS=3600000

# 4. 카카오 OAuth 클라이언트 시크릿
CLIENT_SECRET=your_kakao_client_secret_here